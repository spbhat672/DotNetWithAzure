@{
    ViewData["Title"] = "Task Items";

    var userRole = (int)(ViewBag.UserRole ?? 3);

    // User3 cannot add
    var canAdd = userRole != 3;
}

<div class="container">

    <h2>Task Management</h2>

    <div class="mb-3">
        <span>
            Items: <strong id="itemCount">0</strong>
        </span>

        <button id="btnAdd"
                class="btn btn-primary"
                @(canAdd ? "" : "disabled")>
            Add
        </button>
    </div>

    <table id="taskTable"
           class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Created On</th>
                <th>Updated On</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="taskTableBody">
        </tbody>

    </table>

</div>


<!-- ========================= -->
<!-- Add / Update Modal -->
<!-- ========================= -->

<div id="taskModal"
     class="modal-overlay"
     style="display:none;">

    <div class="modal-box">

        <h3 id="modalTitle">Add Task</h3>

        <input type="hidden" id="taskId" />

        <div class="form-group mb-3">

            <label for="txtTitle">
                Title
            </label>

            <input type="text"
                   id="txtTitle"
                   class="form-control" />

        </div>


        <div class="form-group mb-3">

            <label for="txtDescription">
                Description
            </label>

            <textarea id="txtDescription"
                      class="form-control"
                      rows="4"></textarea>

        </div>


        <div class="buttons">

            <button id="btnSave"
                    class="btn btn-success">
                Save
            </button>

            <button id="btnCancel"
                    class="btn btn-secondary">
                Cancel
            </button>

        </div>

    </div>

</div>